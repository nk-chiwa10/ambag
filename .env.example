# BSC Testnet only. Never put a wallet with real funds here.
# Public testnet:
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
CHAIN_ID=97
# Local fallback (npm run localnet). The organizer recommends this when the
# faucet requires mainnet BNB. Run localnet first, then use these two values:
# RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=31337
CONTRACT_ADDRESS=
VENDOR_ADDRESS=
DEPLOYER_KEY=
# Comma-separated test-only private keys for the three demo members.
MEMBER_KEYS=

# AI extraction. MOCK_AI=1 returns the demo rows without an API call.
MOCK_AI=1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Gemini via its OpenAI-compatible endpoint (works with the same code):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-2.5-flash
